# =============================================================================
# Agenda Sami — plantilla de entorno de producción
# =============================================================================
# Copia este archivo a /etc/agenda-sami/agenda-sami.env y rellena los valores.
# Nunca guardes el archivo real en el repositorio ni en el paquete.
# Permisos recomendados: root:agenda-sami 0640 o agenda-sami:agenda-sami 0600.
# =============================================================================

NODE_ENV=production

# El servidor está fijado por código a 127.0.0.1. HOST se incluye por claridad.
HOST=127.0.0.1
PORT=3001

# Ruta persistente FUERA de la release. El proceso debe poder escribir aquí.
AGENDA_DB_PATH=/var/lib/agenda-sami/agenda_sami.sqlite

# Cloudflare Tunnel conecta desde loopback. Sólo confiar en X-Forwarded-* desde
# esa conexión local; el servidor ya comprueba que el socket sea 127.0.0.1/::1.
TRUST_PROXY=true

# Dominio público exacto (sin barra final). Si frontend y API comparten origen
# no se necesita CORS, pero se declara para evitar orígenes no autorizados.
ALLOWED_ORIGINS=https://agenda.example.com

# Sesiones: 168 h = 7 días.
SESSION_TTL_HOURS=168

# Retención de backups automáticos previos a migración/restauración.
BACKUP_RETENTION_COUNT=10

# Retención de los backups diarios verificados (días).
BACKUP_RETENTION_DAYS=14

# Límites HTTP.
API_MAX_BODY_BYTES=1048576
BACKUP_MAX_BODY_MB=25

# Rate limiting.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
IA_RATE_LIMIT_MAX=30
IA_RATE_LIMIT_WINDOW_MS=300000

# Timeout de proveedores de IA.
AI_TIMEOUT_MS=25000

# Claves opcionales. Déjalas vacías para el modo heurístico local.
# Si las configuras, no las escribas en SQLite ni en el repositorio.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# No activar autologin en producción: la autenticación propia debe permanecer.
AGENDA_LOCAL_AUTOLOGIN=false

# Debe apuntar al archivo de entorno cuando se ejecute fuera de systemd.
# En systemd se carga con EnvironmentFile; esta variable es útil para CLI.
AGENDA_ENV_FILE=/etc/agenda-sami/agenda-sami.env
